# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth.js
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Email (Resend)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="Recessi <recessi@example.com>"
EMAIL_REPLY_TO="assistenza@example.com"
# Se "true" non invia email reali: registra solo l'EmailLog (usare in staging/test).
EMAIL_DRY_RUN="false"

# App
APP_BASE_URL="http://localhost:3000"
DEFAULT_TIMEZONE="Europe/Rome"

# Public form
PUBLIC_FORM_ENABLED="true"
RATE_LIMIT_PER_IP_PER_HOUR="5"
CAPTCHA_ENABLED="false"
CAPTCHA_SECRET_KEY=""

# Seed admin (change in production)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
